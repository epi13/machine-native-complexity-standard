{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/experimental/0.1/mncs-analyzer-result.schema.json",
  "title": "Experimental bounded machine-native analyzer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "invariant_id",
    "status",
    "mode",
    "evidence_partition",
    "subject_id",
    "contract_id",
    "analyzer_id",
    "analyzer_version",
    "configuration_id",
    "environment_id",
    "method",
    "bounded",
    "required_semantics_complete",
    "facts_examined",
    "assumptions",
    "unsupported_constructs",
    "witnesses",
    "counterexamples",
    "resource_usage",
    "limitations",
    "evidence_hash",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.1-experimental"},
    "result_id": {"$ref": "#/$defs/id"},
    "invariant_id": {"$ref": "#/$defs/id"},
    "status": {"$ref": "#/$defs/status"},
    "mode": {"enum": ["evaluator", "repair_feedback"]},
    "evidence_partition": {"$ref": "#/$defs/id"},
    "subject_id": {"$ref": "#/$defs/id"},
    "contract_id": {"$ref": "#/$defs/id"},
    "analyzer_id": {"$ref": "#/$defs/id"},
    "analyzer_version": {"type": "string", "minLength": 1},
    "configuration_id": {"$ref": "#/$defs/id"},
    "environment_id": {"$ref": "#/$defs/id"},
    "method": {"type": "string", "minLength": 1},
    "bounded": {"const": true},
    "required_semantics_complete": {"type": "boolean"},
    "facts_examined": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unsupported_constructs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "witnesses": {"type": "array", "items": {"$ref": "#/$defs/witness"}},
    "counterexamples": {"type": "array", "items": {"$ref": "#/$defs/witness"}},
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "peak_memory_bytes", "input_bytes"],
      "properties": {
        "wall_seconds": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "input_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {"properties": {"required_semantics_complete": {"const": true}}}
    },
    {
      "if": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]},
      "then": {
        "anyOf": [
          {"properties": {"witnesses": {"minItems": 1}}},
          {"properties": {"counterexamples": {"minItems": 1}}}
        ]
      }
    },
    {
      "if": {"properties": {"status": {"const": "UNKNOWN"}}, "required": ["status"]},
      "then": {
        "anyOf": [
          {"properties": {"unsupported_constructs": {"minItems": 1}}},
          {"properties": {"limitations": {"minItems": 1}}}
        ]
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "location", "support"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "identity": {"$ref": "#/$defs/id"},
        "location": {"type": ["string", "null"]},
        "support": {"enum": ["complete", "bounded", "unsupported"]}
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "locations", "data"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "locations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "data": {"type": "object"}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
