{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/experimental/0.1/mncs-replay-receipt.schema.json",
  "title": "MNCS experimental local replay receipt 0.1",
  "description": "Offline evidence that a scoped execution challenge was consumed once in a declared local replay store. It does not establish external custody, host-root resistance, independence, isolation, correctness, conformance, or promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "replay_id", "replay_identity", "challenge_identity", "receipt_identity", "scope", "consumed_at", "store_entry_identity", "previous_entry_identity", "store_head_identity", "time_watermark", "limitations", "extensions"],
  "properties": {
    "schema_version": {"const": "0.1-experimental"},
    "record_type": {"const": "mncs-replay-receipt"},
    "replay_id": {"$ref": "#/$defs/id"},
    "replay_identity": {"$ref": "#/$defs/sha256"},
    "challenge_identity": {"$ref": "#/$defs/sha256"},
    "receipt_identity": {"$ref": "#/$defs/sha256"},
    "scope": {"$ref": "#/$defs/scope"},
    "consumed_at": {"type": "string", "format": "date-time"},
    "store_entry_identity": {"$ref": "#/$defs/sha256"},
    "previous_entry_identity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "store_head_identity": {"$ref": "#/$defs/sha256"},
    "time_watermark": {"type": "string", "format": "date-time"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_identity", "candidate_id", "bundle_identity", "execution_policy_identity", "runner_identity"],
      "properties": {
        "subject_identity": {"$ref": "#/$defs/sha256"},
        "candidate_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "bundle_identity": {"$ref": "#/$defs/sha256"},
        "execution_policy_identity": {"$ref": "#/$defs/sha256"},
        "runner_identity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"}, "additionalProperties": true}
  }
}
