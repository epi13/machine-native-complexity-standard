{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.3-rc.1/mncs-measurement-profile.schema.json",
  "title": "MNCS 0.3-rc.1 measurement profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mncs_version", "profile_id", "baseline_id", "candidate_id",
    "metric", "unit", "direction", "operational_relevance", "environment_id",
    "hardware_id", "software_id", "evaluator_id", "benchmark_id", "warmup",
    "sample_count", "repetitions", "ordering", "randomization", "summary_statistics",
    "uncertainty", "noise_policy", "outlier_policy", "hard_constraints",
    "worst_regression_limit", "pareto_treatment", "normalization",
    "contamination_controls", "useful_benefit_threshold", "freshness",
    "reporting_mode", "status", "limitations", "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.3-rc.1"},
    "mncs_version": {"const": "0.3-rc.1"},
    "profile_id": {"$ref": "#/$defs/id"},
    "baseline_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "metric": {"$ref": "#/$defs/text"},
    "unit": {"$ref": "#/$defs/text"},
    "direction": {"enum": ["minimize", "maximize"]},
    "operational_relevance": {"$ref": "#/$defs/text"},
    "environment_id": {"$ref": "#/$defs/id"},
    "hardware_id": {"$ref": "#/$defs/id"},
    "software_id": {"$ref": "#/$defs/id"},
    "evaluator_id": {"$ref": "#/$defs/id"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "warmup": {"$ref": "#/$defs/text"},
    "sample_count": {"type": "integer", "minimum": 2},
    "repetitions": {"type": "integer", "minimum": 2},
    "ordering": {"enum": ["fixed", "alternating", "randomized", "blocked"]},
    "randomization": {"$ref": "#/$defs/text"},
    "summary_statistics": {"$ref": "#/$defs/nonEmptyTexts"},
    "uncertainty": {"$ref": "#/$defs/text"},
    "noise_policy": {"$ref": "#/$defs/text"},
    "outlier_policy": {"$ref": "#/$defs/text"},
    "hard_constraints": {"$ref": "#/$defs/texts"},
    "worst_regression_limit": {"$ref": "#/$defs/text"},
    "pareto_treatment": {"$ref": "#/$defs/text"},
    "normalization": {"$ref": "#/$defs/text"},
    "contamination_controls": {"$ref": "#/$defs/nonEmptyTexts"},
    "useful_benefit_threshold": {"$ref": "#/$defs/text"},
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluated_at", "valid_until", "policy_id", "status"],
      "properties": {
        "evaluated_at": {"type": "string", "format": "date-time"},
        "valid_until": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "policy_id": {"$ref": "#/$defs/id"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "reporting_mode": {"enum": ["all_repetitions", "predeclared_summary", "best_run_only"]},
    "status": {"$ref": "#/$defs/status"},
    "limitations": {"$ref": "#/$defs/texts"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "nonEmptyTexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
