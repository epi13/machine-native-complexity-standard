{
  "schema_version": "mncs-family.repository-manifest/v0alpha1",
  "repository": "mncs-control",
  "revision": 1,
  "contracts": {
    "provides": [
      {
        "contract": "concept-experiment-manifest",
        "version": "0.1",
        "kind": "record-schema",
        "stability": "experimental",
        "fingerprint_sources": [
          "src/mncs_control_mcp/experiments.py"
        ],
        "consumers_declared": [
          "mncs-commons"
        ]
      },
      {
        "contract": "replication-pipeline",
        "version": "0.4.10",
        "kind": "service-surface",
        "stability": "experimental",
        "fingerprint_sources": [
          "src/mncs_control_mcp/replication.py"
        ]
      },
      {
        "contract": "journal-context",
        "version": "1",
        "kind": "projection-surface",
        "stability": "experimental",
        "fingerprint_sources": [
          "src/mncs_control_mcp/journal_context.py"
        ],
        "consumers_declared": [
          "mncs-atlas"
        ]
      }
    ],
    "consumes": [
      {
        "contract": "mncs-forge.concept-evaluation-record",
        "envelope": {
          "op": "any"
        },
        "required": true,
        "evidence_refs": [
          "src/mncs_control_mcp/adapters.py"
        ]
      },
      {
        "contract": "mncs-fabric.family-execution-reference",
        "envelope": {
          "op": "any"
        },
        "required": true,
        "evidence_refs": [
          "src/mncs_control_mcp/replication.py"
        ]
      },
      {
        "contract": "mncs-harness.actor-provenance",
        "envelope": {
          "op": "any"
        },
        "required": true,
        "evidence_refs": [
          "src/mncs_control_mcp/experiments.py"
        ]
      },
      {
        "contract": "mncs-language.cli-toolchain",
        "envelope": {
          "op": "at-least",
          "version": "0.5"
        },
        "required": true,
        "evidence_refs": [
          "control.toml",
          "docs/EXPERIMENT-REPLICATION.md"
        ]
      },
      {
        "contract": "mncs-commons.family-record-spine",
        "envelope": {
          "op": "at-least",
          "version": "0.1"
        },
        "required": true,
        "evidence_refs": [
          "src/mncs_control_mcp/replication.py"
        ]
      }
    ],
    "tests": [
      {
        "test": "pytest",
        "covers": [
          "concept-experiment-manifest",
          "replication-pipeline",
          "journal-context"
        ],
        "obligation": "self",
        "command": {
          "argv": [
            "pytest",
            "-q"
          ],
          "timeout_seconds": 2400
        }
      }
    ]
  },
  "manifest_location": "central"
}
