{
  "schema_version": "mncs-family-registry.v0.1",
  "registry_id": "mncs-family",
  "name": "MNCS family",
  "description": "Discovery and bootstrap map for the Machine-Native Complexity Standard and the independently owned projects that implement, evaluate, execute, record, and research machine-native computing. Component repositories remain authoritative for their own contracts.",
  "authority": {
    "kind": "discovery-and-bootstrap",
    "does_not_create": [
      "conformance",
      "certification",
      "independent evidence",
      "protected custody",
      "governance approval",
      "PASS",
      "promotion authority"
    ],
    "note": "A successful bootstrap means software was installed and verified against this operational contract. It does not change MNCS or MNCDS claim status."
  },
  "compatibility": {
    "state": "UNKNOWN",
    "note": "No published compatible-set matrix yet. Refs default to each repository's main branch unless an explicit --ref is supplied. Treat cross-component version compatibility as UNKNOWN."
  },
  "profiles": {
    "core": {
      "display_name": "Core",
      "description": "MNCS standard, Python validator, and optional independent Rust validator.",
      "components": ["mncs"],
      "optional_components": ["mncs-validator-rs"]
    },
    "developer": {
      "display_name": "Developer",
      "description": "Core plus the common development stack: MNCDS, Fabric, Harness, Forge, Commons, and Control MCP.",
      "components": [
        "mncs",
        "mncds",
        "mncs-fabric",
        "mncs-commons",
        "mncs-harness",
        "mncs-forge",
        "mncs-control"
      ],
      "optional_components": ["mncs-validator-rs"]
    },
    "worker": {
      "display_name": "Fabric worker",
      "description": "Fabric worker checkout and preflight. Enrollment, certificates, and controller rendezvous remain operator-mediated Fabric operations.",
      "components": ["mncs-fabric"]
    },
    "research": {
      "display_name": "Research",
      "description": "Developer stack plus language, studies, experimental learning, RAVEL, Atlas, lineage, and rights/provenance research.",
      "components": [
        "mncs",
        "mncds",
        "mncs-fabric",
        "mncs-commons",
        "mncs-harness",
        "mncs-forge",
        "mncs-control",
        "mncs-language",
        "mncs-reference-studies",
        "mnel",
        "ravel",
        "mncs-atlas",
        "mncs-lineage",
        "mncs-rights-provenance"
      ],
      "optional_components": ["mncs-validator-rs"]
    },
    "full": {
      "display_name": "Full",
      "description": "Every registered family component that this host can support.",
      "components": [
        "mncs",
        "mncds",
        "mncs-validator-rs",
        "mncs-fabric",
        "mncs-commons",
        "mncs-harness",
        "mncs-forge",
        "mncs-control",
        "mncs-language",
        "mncs-reference-studies",
        "mnel",
        "ravel",
        "mncs-atlas",
        "mncs-lineage",
        "mncs-rights-provenance"
      ]
    }
  },
