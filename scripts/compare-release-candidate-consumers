#!/usr/bin/env python3
"""Compare Python and independent Rust release-candidate corpus decisions."""

from __future__ import annotations

import argparse
import json
import subprocess
from pathlib import Path
from typing import Any, cast

from mncs_validator.rc_corpus import load_cases, run_corpus


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--corpus",
        type=Path,
        default=Path("conformance/release-candidate/corpus.json"),
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    python_summary, python_results = run_corpus(args.corpus)
    _, cases = load_cases(args.corpus)
    required_codes = {
        cast(str, case["id"]): set(cast(list[str], case.get("issue_codes", []))) for case in cases
    }
    process = subprocess.run(
        [
            "cargo",
            "run",
            "--quiet",
            "--manifest-path",
            "independent/rc-consumer/Cargo.toml",
            "--",
            str(args.corpus),
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if process.returncode not in {0, 1}:
        payload = {
            "category": "IMPLEMENTATION_ERROR",
            "consumer": "mncs-rc-consumer",
            "returncode": process.returncode,
            "stderr": process.stderr,
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 2
    rust = cast(dict[str, Any], json.loads(process.stdout))
    rust_results = {item["id"]: item for item in cast(list[dict[str, Any]], rust["results"])}
    disagreements = []
    for python in python_results:
        other = rust_results.get(python["id"])
        required = required_codes[cast(str, python["id"])]
        python_codes = set(cast(list[str], python["issue_codes"]))
        rust_codes = set() if other is None else set(cast(list[str], other.get("issue_codes", [])))
        if (
            other is None
            or other["actual"] != python["actual"]
            or not required <= python_codes
            or not required <= rust_codes
        ):
            disagreements.append(
                {
                    "id": python["id"],
                    "python": python["actual"],
                    "rust": None if other is None else other["actual"],
                    "required_issue_codes": sorted(required),
                    "python_issue_codes": sorted(python_codes),
                    "rust_issue_codes": sorted(rust_codes),
                }
            )
    payload = {
        "corpus": str(args.corpus),
        "python": python_summary.as_dict(),
        "rust": rust["summary"],
        "agreement": len(python_results) - len(disagreements),
        "disagreement": len(disagreements),
        "disagreements": disagreements,
        "issue_code_comparison": "exact required corpus issue-code subset",
        "independent_implementation": True,
        "independent_executable": True,
        "independent_operator": "UNKNOWN",
        "organizational_independence": "UNKNOWN",
    }
    print(json.dumps(payload, indent=2 if args.json else None, sort_keys=True))
    return 0 if not disagreements else 1


if __name__ == "__main__":
    raise SystemExit(main())
