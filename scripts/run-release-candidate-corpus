#!/usr/bin/env python3
"""Run the MNCS 0.3 and MNCDS 0.1 release-candidate corpus offline."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from mncs_validator.rc_corpus import default_corpus_path, run_corpus


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--corpus",
        type=Path,
        default=default_corpus_path(),
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    summary, results = run_corpus(args.corpus)
    payload = {"summary": summary.as_dict(), "results": results}
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for result in results:
            marker = "ok" if result["matched"] else "MISMATCH"
            print(f"{marker:8} {result['id']}: {result['actual']} (expected {result['expected']})")
        print(json.dumps(summary.as_dict(), sort_keys=True))
    return 0 if summary.mismatched == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
