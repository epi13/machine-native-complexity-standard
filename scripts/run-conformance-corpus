#!/usr/bin/env python3
"""Run the deterministic MNCS conformance corpus."""

# SPDX-License-Identifier: Apache-2.0

from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from mncs_validator.errors import SchemaNotFoundError
from mncs_validator.schemas import schema_path
from mncs_validator.validation import validate_bundle

ROOT = Path(__file__).resolve().parents[1]
CORPUS = ROOT / "conformance-corpus"


def main() -> int:
    expected = json.loads((CORPUS / "expected.json").read_text(encoding="utf-8"))
    results: list[dict[str, Any]] = []
    mismatches = 0
    for case in expected["cases"]:
        report = validate_bundle(CORPUS / case["path"])
        observed: dict[str, Any] = {
            "id": case["id"],
            "valid": report.valid,
            "computed_status": report.computed_status,
            "legacy": report.legacy_self_asserted_acceptance,
        }
        matches = report.valid is case["valid"]
        if "computed_status" in case:
            matches = matches and report.computed_status == case["computed_status"]
        if "legacy" in case:
            matches = matches and report.legacy_self_asserted_acceptance is case["legacy"]
        observed["matches"] = matches
        mismatches += int(not matches)
        results.append(observed)
    for relative in expected["operational_cases"]:
        operation = json.loads((CORPUS / relative).read_text(encoding="utf-8"))
        matches = False
        try:
            schema_path(operation["schema"])
        except SchemaNotFoundError:
            matches = True
        results.append(
            {
                "id": relative.removesuffix("/case.json"),
                "operational_result": "operational-error" if matches else "unexpected-success",
                "matches": matches,
            }
        )
        mismatches += int(not matches)
    output = {
        "schema_version": "0.1.1",
        "case_count": len(results),
        "mismatch_count": mismatches,
        "results": results,
    }
    print(json.dumps(output, indent=2, sort_keys=True))
    return 1 if mismatches else 0


if __name__ == "__main__":
    raise SystemExit(main())
