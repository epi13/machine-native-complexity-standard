{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/experimental/0.1/mncs-assurance-case.schema.json",
  "title": "Experimental combined MNCS and MNCDS assurance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assurance_case_id",
    "candidate_id",
    "release_id",
    "contract_id",
    "environment_id",
    "criticality",
    "applicability_policy_id",
    "trust_policy_id",
    "mncs",
    "mncds",
    "dependencies",
    "authorities",
    "unresolved_unknowns",
    "deviations",
    "limitations",
    "freshness",
    "rollback",
    "replacement",
    "supersedes",
    "disposition",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.1-experimental"},
    "assurance_case_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "release_id": {"$ref": "#/$defs/id"},
    "contract_id": {"$ref": "#/$defs/id"},
    "environment_id": {"$ref": "#/$defs/id"},
    "criticality": {"enum": ["low", "moderate", "high", "critical"]},
    "applicability_policy_id": {"$ref": "#/$defs/id"},
    "trust_policy_id": {"$ref": "#/$defs/id"},
    "contract_profile_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "combined_label": {"type": "string", "pattern": "^MNCDS-D[1-4] / MNCS-L[1-5]$"},
    "mncs": {"$ref": "#/$defs/mncsClaim"},
    "mncds": {"$ref": "#/$defs/mncdsClaim"},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "relation",
          "required",
          "status",
          "claim_id",
          "environment_compatible",
          "correlation_group",
          "invalidation_triggers"
        ],
        "properties": {
          "dependency_id": {"$ref": "#/$defs/id"},
          "relation": {"enum": ["runtime", "build", "service", "data", "evaluator", "evidence", "interface"]},
          "required": {"type": "boolean"},
          "status": {"$ref": "#/$defs/status"},
          "claim_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "environment_compatible": {"$ref": "#/$defs/status"},
          "correlation_group": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "invalidation_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "authority_id"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "authority_id": {"$ref": "#/$defs/id"}
        }
      }
    },
    "unresolved_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "rationale", "risk"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated_at", "expires_at", "revalidation_triggers"],
      "properties": {
        "evaluated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "revalidation_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "procedure_id", "test_status"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "procedure_id": {"$ref": "#/$defs/id"},
        "test_status": {"$ref": "#/$defs/status"}
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regeneration_spec_id", "owner_id", "retirement_triggers"],
      "properties": {
        "regeneration_spec_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "retirement_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "policy_id", "rationale"],
      "properties": {
        "decision": {"enum": ["accepted", "rejected", "review_required"]},
        "policy_id": {"$ref": "#/$defs/id"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "mncsClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "level", "status", "result_id", "scope_id", "issues", "limitations"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "level": {"enum": ["MNCS-L1", "MNCS-L2", "MNCS-L3", "MNCS-L4", "MNCS-L5"]},
        "status": {"$ref": "#/$defs/status"},
        "result_id": {"$ref": "#/$defs/id"},
        "scope_id": {"$ref": "#/$defs/id"},
        "issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "mncdsClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "status", "result_id", "scope_id", "issues", "limitations"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "profile": {"enum": ["MNCDS-D1", "MNCDS-D2", "MNCDS-D3", "MNCDS-D4"]},
        "status": {"$ref": "#/$defs/status"},
        "result_id": {"$ref": "#/$defs/id"},
        "scope_id": {"$ref": "#/$defs/id"},
        "issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
