{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mncs.dev/schema/experimental/0.2/mncs-composed-assurance-case.schema.json","title":"Experimental composed assurance case","type":"object","additionalProperties":false,"required":["schema_version","record_id","system_contract_id","components","boundaries","environments","composition_policy","propagated_result","known_limitations","residual_risks","formal_mncs_status","formal_mncds_status","promotion_authorized","extensions"],"properties":{"schema_version":{"const":"0.2-experimental"},"record_id":{"type":"string","minLength":1},"system_contract_id":{"type":"string","minLength":1},"components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/result"}},"boundaries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/result"}},"environments":{"type":"array","minItems":1,"items":{"type":"string"}},"composition_policy":{"type":"object","required":["precedence","missing_required","unknown_review"],"properties":{"precedence":{"const":["FAIL","UNKNOWN","PASS"]},"missing_required":{"const":"UNKNOWN"},"unknown_review":{"enum":["UNKNOWN","REVIEW_REQUIRED"]}}},"propagated_result":{"enum":["PASS","FAIL","UNKNOWN","REVIEW_REQUIRED"]},"known_limitations":{"type":"array","items":{"type":"string"}},"residual_risks":{"type":"array","items":{"type":"string"}},"formal_mncs_status":{"enum":["PASS","FAIL","UNKNOWN"]},"formal_mncds_status":{"enum":["PASS","FAIL","UNKNOWN"]},"promotion_authorized":{"type":"boolean"},"extensions":{"type":"object"}},"$defs":{"result":{"type":"object","additionalProperties":false,"required":["id","kind","required","status","evidence_ref","environment_id"],"properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["component","boundary"]},"required":{"type":"boolean"},"status":{"enum":["PASS","FAIL","UNKNOWN"]},"evidence_ref":{"type":"string","minLength":1},"environment_id":{"type":"string","minLength":1}}}}}
