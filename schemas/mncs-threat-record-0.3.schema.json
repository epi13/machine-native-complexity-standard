{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.3-rc.1/mncs-threat-record.schema.json",
  "title": "MNCS 0.3-rc.1 threat record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mncs_version", "threat_id", "category", "affected_planes",
    "assets", "actor_or_failure_source", "preconditions", "path", "assumptions",
    "mitigations", "detection_signals", "residual_risk", "owner_id",
    "revalidation_triggers", "privacy_impact", "status", "limitations", "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.3-rc.1"},
    "mncs_version": {"const": "0.3-rc.1"},
    "threat_id": {"$ref": "#/$defs/id"},
    "category": {"$ref": "#/$defs/text"},
    "affected_planes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["human", "machine_execution", "evidence", "development_control", "operational_control"]}
    },
    "assets": {"$ref": "#/$defs/nonEmptyTexts"},
    "actor_or_failure_source": {"$ref": "#/$defs/text"},
    "preconditions": {"$ref": "#/$defs/texts"},
    "path": {"$ref": "#/$defs/nonEmptyTexts"},
    "assumptions": {"$ref": "#/$defs/texts"},
    "mitigations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mitigation_id", "summary", "evidence_ids", "status"],
        "properties": {
          "mitigation_id": {"$ref": "#/$defs/id"},
          "summary": {"$ref": "#/$defs/text"},
          "evidence_ids": {"$ref": "#/$defs/ids"},
          "status": {"$ref": "#/$defs/status"}
        }
      }
    },
    "detection_signals": {"$ref": "#/$defs/texts"},
    "residual_risk": {"enum": ["negligible", "low", "moderate", "high", "critical", "unknown"]},
    "owner_id": {"$ref": "#/$defs/id"},
    "revalidation_triggers": {"$ref": "#/$defs/nonEmptyTexts"},
    "privacy_impact": {"$ref": "#/$defs/text"},
    "status": {"$ref": "#/$defs/status"},
    "limitations": {"$ref": "#/$defs/texts"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "nonEmptyTexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
