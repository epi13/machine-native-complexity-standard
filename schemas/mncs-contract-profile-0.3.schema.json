{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/0.3-rc.1/mncs-contract-profile.schema.json",
  "title": "MNCS 0.3-rc.1 contract adequacy profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mncs_version", "profile_id", "contract_id",
    "contract_content_identity", "correctness_basis", "status", "intended_use", "interfaces", "behavior",
    "limits", "invariants", "environment_assumptions", "compatibility",
    "undefined_behavior", "reference_oracle", "ambiguities", "versioning",
    "findings", "evidence_ids", "limitations", "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.3-rc.1"},
    "mncs_version": {"const": "0.3-rc.1"},
    "profile_id": {"$ref": "#/$defs/id"},
    "contract_id": {"$ref": "#/$defs/id"},
    "contract_content_identity": {"$ref": "#/$defs/hash"},
    "correctness_basis": {"enum": ["independent_contract", "candidate_behavior"]},
    "status": {"$ref": "#/$defs/status"},
    "intended_use": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "exclusions"],
      "properties": {
        "statement": {"$ref": "#/$defs/text"},
        "exclusions": {"$ref": "#/$defs/texts"}
      }
    },
    "interfaces": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs", "outputs", "state", "state_transitions"],
      "properties": {
        "inputs": {"$ref": "#/$defs/nonEmptyTexts"},
        "outputs": {"$ref": "#/$defs/nonEmptyTexts"},
        "state": {"$ref": "#/$defs/texts"},
        "state_transitions": {"$ref": "#/$defs/texts"}
      }
    },
    "behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["observable", "errors", "malformed_inputs", "adversarial_inputs", "external_effects"],
      "properties": {
        "observable": {"$ref": "#/$defs/nonEmptyTexts"},
        "errors": {"$ref": "#/$defs/nonEmptyTexts"},
        "malformed_inputs": {"$ref": "#/$defs/nonEmptyTexts"},
        "adversarial_inputs": {"$ref": "#/$defs/texts"},
        "external_effects": {"$ref": "#/$defs/texts"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "timing", "resource_applicability", "timing_applicability"],
      "properties": {
        "resource": {"$ref": "#/$defs/texts"},
        "timing": {"$ref": "#/$defs/texts"},
        "resource_applicability": {"$ref": "#/$defs/applicability"},
        "timing_applicability": {"$ref": "#/$defs/applicability"}
      }
    },
    "invariants": {
      "type": "object", "additionalProperties": false,
      "required": ["safety", "security"],
      "properties": {
        "safety": {"$ref": "#/$defs/texts"},
        "security": {"$ref": "#/$defs/texts"}
      }
    },
    "environment_assumptions": {"$ref": "#/$defs/nonEmptyTexts"},
    "compatibility": {"$ref": "#/$defs/texts"},
    "undefined_behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["undefined", "implementation_defined", "excluded"],
      "properties": {
        "undefined": {"$ref": "#/$defs/texts"},
        "implementation_defined": {"$ref": "#/$defs/texts"},
        "excluded": {"$ref": "#/$defs/texts"}
      }
    },
    "reference_oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "limitations", "tolerances"],
      "properties": {
        "identity": {"$ref": "#/$defs/id"},
        "limitations": {"$ref": "#/$defs/texts"},
        "tolerances": {"$ref": "#/$defs/texts"}
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ambiguity_id", "material", "demonstrated_violation", "summary"],
        "properties": {
          "ambiguity_id": {"$ref": "#/$defs/id"},
          "material": {"type": "boolean"},
          "demonstrated_violation": {"type": "boolean"},
          "summary": {"$ref": "#/$defs/text"}
        }
      }
    },
    "versioning": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "material_change_rule", "supersedes_contract_id"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/text"},
        "material_change_rule": {"$ref": "#/$defs/text"},
        "supersedes_contract_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "findings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "field", "required", "status", "summary", "evidence_ids"],
        "properties": {
          "rule_id": {"$ref": "#/$defs/rule"},
          "field": {"$ref": "#/$defs/text"},
          "required": {"type": "boolean"},
          "status": {"$ref": "#/$defs/status"},
          "summary": {"$ref": "#/$defs/text"},
          "evidence_ids": {"$ref": "#/$defs/ids"}
        }
      }
    },
    "evidence_ids": {"$ref": "#/$defs/ids"},
    "limitations": {"$ref": "#/$defs/texts"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rule": {"type": "string", "pattern": "^MNCS-03-[A-Z0-9-]+$"},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "nonEmptyTexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["applicable", "rationale"],
      "properties": {"applicable": {"type": "boolean"}, "rationale": {"$ref": "#/$defs/text"}}
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": true
    }
  }
}
