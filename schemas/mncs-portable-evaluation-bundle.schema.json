{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/experimental/0.5/mncs-portable-evaluation-bundle.schema.json",
  "title": "Experimental MNCS portable evaluation bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_format",
    "candidate_freeze_identity",
    "evaluator_identity",
    "workload_identity",
    "created_at",
    "minimum_python",
    "entrypoint",
    "network_policy",
    "supported_platforms",
    "result_schema",
    "claim_boundary",
    "files",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "0.5-experimental"},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_format": {"const": "mncs-portable-evaluator-v1"},
    "candidate_freeze_identity": {"$ref": "#/$defs/identity"},
    "evaluator_identity": {"$ref": "#/$defs/identity"},
    "workload_identity": {"$ref": "#/$defs/identity"},
    "created_at": {"type": "string", "format": "date-time"},
    "minimum_python": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "entrypoint": {"type": "string", "minLength": 1},
    "network_policy": {"type": "string", "minLength": 1},
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "result_schema": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "identity", "size"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/].*"},
          "identity": {"$ref": "#/$defs/identity"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
