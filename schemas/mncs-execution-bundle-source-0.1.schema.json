{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schema/experimental/0.1/mncs-execution-bundle-source.schema.json",
  "title": "MNCS experimental execution bundle source manifest 0.1",
  "description": "A bounded builder input that maps source-root files into an immutable execution bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "bundle_id", "entries", "entrypoints", "runtime_requirements", "policy_references", "limits", "extensions"],
  "properties": {
    "schema_version": {"const": "0.1-experimental"},
    "record_type": {"const": "mncs-execution-bundle-source"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "entries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "source", "role", "mode"], "properties": {"path": {"$ref": "#/$defs/path"}, "source": {"$ref": "#/$defs/path"}, "role": {"$ref": "#/$defs/role"}, "mode": {"enum": ["0644", "0755"]}}}},
    "entrypoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "path"], "properties": {"name": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}}}},
    "runtime_requirements": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "policy_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "limits": {"$ref": "#/$defs/limits"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\\\\\u0000]+$"},
    "role": {"enum": ["test", "harness", "expected", "manifest", "fixture", "input", "runtime-requirement", "policy-reference", "support"]},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_file_count", "max_file_bytes", "max_total_bytes", "max_path_bytes", "max_expansion_ratio"], "properties": {"max_file_count": {"type": "integer", "minimum": 1}, "max_file_bytes": {"type": "integer", "minimum": 1}, "max_total_bytes": {"type": "integer", "minimum": 1}, "max_path_bytes": {"type": "integer", "minimum": 1}, "max_expansion_ratio": {"type": "integer", "minimum": 1}}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"}, "additionalProperties": true}
  }
}
